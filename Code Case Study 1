<!DOCTYPE html> 
<html lang="en"> 
<head> 
    <meta charset="UTF-8"> 
    <meta name="viewport" content="width=device-width, initial
scale=1.0"> 
    <title>SIT Nagpur - IT Department</title> 
     
    <!-- Internal CSS for styling matching the template --> 
    <style> 
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans
serif; 
            background-color: #f3f4f6; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
        } 
        .card { 
            background: white; 
            padding: 40px; 
            border-radius: 12px; 
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); 
            text-align: center; 
            max-width: 500px; 
            width: 100%; 
            border-top: 8px solid #064e3b; 
        } 
        h1 { 
            color: #1f2937; 
            font-size: 2.5rem; 
            margin-bottom: 5px; 
        } 
        h2 { 
            color: #065f46; 
            font-size: 1.3rem; 
            font-weight: 500; 
            margin-top: 0; 
            margin-bottom: 25px; 
        } 
        p { 
            color: #6b7280; 
            font-size: 1rem; 
            line-height: 1.6; 
            margin-bottom: 30px; 
        } 
        .btn { 
            background-color: #0ea5e9; 
            color: white; 
            border: none; 
            padding: 12px 28px; 
            font-size: 1rem; 
            font-weight: 600; 
            border-radius: 6px; 
            cursor: pointer; 
            transition: background-color 0.2s ease; 
        } 
        .btn:hover { 
            background-color: #0284c7; 
        } 
    </style> 
 
    <!-- Internal JavaScript --> 
    <script> 
        // Console methods demo inside internal script 
        console.log("Internal JS loaded. Webpage initialized."); 
        console.error("This is a simulated system check tracking errors 
(None found)."); 
 
        // Welcome message on window load 
        window.onload = function() { 
            console.log("Webpage fully loaded and rendered."); 
        }; 
    </script> 
</head> 
<body> 
 
    <div class="card"> 
        <h1>SIT Nagpur</h1> 
        <h2>Information Technology Department</h2> 
        <p>Welcome to our official department webpage. Click below to 
view student details.</p> 
         
        <!-- Inline JavaScript to trigger external function and a 
console tracking log --> 
        <button class="btn" onclick="console.log('Button clicked.'); 
displayStudentInfo();"> 
            View Student Information 
        </button> 
    </div> 
 
    <!-- Linking External JavaScript --> 
    <script src="script.js"></script> 
</body> 
</html>
